# Copy this file to .env before running `make up`.
# These are sample credentials for a local practice environment only.
#
#     cp .env.example .env
#
# .env is not committed; this file is. Every variable docker-compose.yml reads
# appears here with an explanation.

# --- Stores -------------------------------------------------------------
# Display names, in Spanish, shown on each store's point of sale. The store
# IDENTIFIERS (store-1, store-2) are fixed in docker-compose.yml and must match
# the rows seeded in central-db/02-seed.sql.
STORE_1_NAME=Tienda 1 - Chapinero
STORE_2_NAME=Tienda 2 - Kennedy

# --- Store databases (PostgreSQL, one per store) ------------------------
# Both stores use the same credentials because they run the same software; they
# do NOT share a database. Each has its own container and its own volume.
POSTGRES_USER=store
POSTGRES_PASSWORD=store_password
POSTGRES_DB=store

# Published so you can inspect each store's database with psql, DBeaver or
# pgAdmin from your own machine. Deliberately not 5432: that is the most
# commonly occupied port on a developer machine, and a first `make up` that
# dies on a port collision looks like a broken exercise rather than a local
# conflict.
STORE_1_POSTGRES_HOST_PORT=55432
STORE_2_POSTGRES_HOST_PORT=55433

# --- Store backends -----------------------------------------------------
# Seconds to wait for the payment gateway before giving up.
PAYMENT_GATEWAY_TIMEOUT_SECONDS=5

# Published for `curl` and for the interactive docs at /docs. Not 8000, for the
# same reason the databases are not 5432.
STORE_1_BACKEND_HOST_PORT=18000
STORE_2_BACKEND_HOST_PORT=18001

# --- Cash registers -----------------------------------------------------
# Each register serves its store's web site on its own port. These are the only
# doors into the sites: neither frontend container publishes a host port, so
# you always reach a store's web site through one of its registers, the way a
# cashier does.
STORE_1_REGISTER_1_HOST_PORT=8081
STORE_1_REGISTER_2_HOST_PORT=8082
STORE_2_REGISTER_1_HOST_PORT=8083
STORE_2_REGISTER_2_HOST_PORT=8084

# --- Sale forwarding ----------------------------------------------------
# Each store queues its approved sales in its own database and ships them to
# head office in batches. A batch goes out on whichever of these fires FIRST:
#
#   * BATCH_SIZE invoices are queued, or
#   * the OLDEST queued invoice reaches BATCH_MAX_AGE_SECONDS.
#
# The age is measured from the oldest queued invoice, not from the last batch,
# so no sale ever waits longer than BATCH_MAX_AGE_SECONDS plus one poll.
BATCH_SIZE=10
BATCH_MAX_AGE_SECONDS=60

# How often the forwarder looks. This is the price of the age trigger's
# precision: worst case, a sale waits BATCH_MAX_AGE_SECONDS + SYNC_POLL_SECONDS.
SYNC_POLL_SECONDS=5

# TIP: to watch the batching without waiting a minute, set
# BATCH_MAX_AGE_SECONDS=10 and run `make logs CONTAINER=store-1-sync`.

# --- Central site (MySQL) -----------------------------------------------
CENTRAL_MYSQL_ROOT_PASSWORD=central_root_password
CENTRAL_MYSQL_DATABASE=central
CENTRAL_MYSQL_USER=central
CENTRAL_MYSQL_PASSWORD=central_password

# Not 3306, for the same reason the store databases are not 5432.
CENTRAL_MYSQL_HOST_PORT=33306

# --- Central API and dashboard ------------------------------------------
CENTRAL_API_HOST_PORT=18100
CENTRAL_WEB_HOST_PORT=8080

# How many products the "top products" chart shows.
TOP_PRODUCTS_LIMIT=10

# --- Payment gateway ----------------------------------------------------
# Charges above this amount are declined. Deterministic on purpose: it lets the
# integration test force a decline on demand, and keeps a real failure from
# being dismissed as bad luck.
DECLINE_THRESHOLD=1000000

# Where the gateway keeps its own transaction records, separate from every
# store database and from head office's.
GATEWAY_DATABASE_URL=sqlite:////data/gateway.db
